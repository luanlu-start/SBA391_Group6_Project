# Local Docker ports approved for the project.
FRONTEND_PORT=15173
BACKEND_PORT=18080
MONGO_PORT=37017
SQLSERVER_PORT=31433
BACKEND_PROFILES=dev,demo
# Fill these from the team configuration. Never commit actual secrets.
SQLSERVER_PASSWORD=
JWT_SECRET=
AUTH_COOKIE_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=
MAIL_FROM_NAME=FPTPost
MAIL_TEMPLATE_CACHE=false
# Optional Mailpit profile only; the team environment uses Gmail.
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025
