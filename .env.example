# Optional Compose settings: copy to .env to override defaults.
FRONTEND_PORT=5173
BACKEND_PORT=8080
MONGO_PORT=27017
SQLSERVER_PORT=1433
# Optional backend connection override. Empty uses the SQL Server service in Compose.
SQLSERVER_URL=
SQLSERVER_USERNAME=sa
# Set your own strong local password before starting Docker. Keep .env out of Git.
SQLSERVER_PASSWORD=
# Use dev,demo to load missing demo products. Use dev for an empty/new database.
BACKEND_PROFILES=dev
# Base64 of at least 32 random bytes; keep the same secret across backend instances.
# If empty in dev, a temporary key is generated at startup. Required in prod.
JWT_SECRET=
# Set true with HTTPS; localhost HTTP uses false.
AUTH_COOKIE_SECURE=false
# Local OTP email inbox and SMTP listener (Mailpit).
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@fptpost.local
MAIL_FROM_NAME=FPTPost
MAIL_TEMPLATE_CACHE=false
# VNPay Sandbox credentials from your merchant account; required for payment features.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=