# Backend API Base URL
VITE_API_URL=http://localhost:18080/api/v1

# Frontend development port (match FRONTEND_PORT in the root .env)
VITE_DEV_PORT=15173

# App Configuration
VITE_APP_TITLE=FPTPost - Nền tảng giao hàng cowork P2P

# Free Maps Configuration (Bản đồ & Đường sá Việt Nam)
# Các tùy chọn VITE_MAPS_PROVIDER:
# 1. 'google' (Khuyên dùng): Miễn phí hoàn toàn, hiển thị 100% đường xá, ngõ ngách, tên đường tiếng Việt tại Việt Nam rõ nét nhất. Không cần API key.
# 2. 'osm': Bản đồ OpenStreetMap tiêu chuẩn (miễn phí).
# 3. 'voyager': CartoDB Voyager đường phố sáng rõ (miễn phí).
# 4. 'locationiq': Bản đồ LocationIQ Streets (cần API key miễn phí từ https://locationiq.com - 5,000 req/ngày).
# 5. 'geoapify': Bản đồ Geoapify OSM Bright (cần API key miễn phí từ https://geoapify.com - 3,000 req/ngày).
VITE_MAPS_PROVIDER=google
VITE_MAPS_API_KEY=
