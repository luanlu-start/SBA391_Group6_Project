# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# SQL Server: create group6_project_db first when running without Compose.
SQLSERVER_URL=jdbc:sqlserver://localhost:1433;databaseName=group6_project_db;encrypt=true;trustServerCertificate=true
SQLSERVER_USERNAME=sa
SQLSERVER_PASSWORD=Group6_Local_2026!

# MongoDB stores activity history.
# Local: mongodb://localhost:27017/group6_project_db
# Cloud (Atlas): mongodb+srv://<username>:<password>@cluster0.mongodb.net/group6_project_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/group6_project_db

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
