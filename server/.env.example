# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
COMPUTERNAME="DESKTOP-I51HC78"
# SQL Server: create group6_project_db first when running without Compose.
SQLSERVER_URL="jdbc:sqlserver://${COMPUTERNAME}:1433;databaseName=group6_project_db;encrypt=true;trustServerCertificate=true"
SQLSERVER_USERNAME=sa
# Set this to your local SQL Server password. Keep the actual value out of Git.
SQLSERVER_PASSWORD=123

# MongoDB stores activity history.
# Local: mongodb://localhost:27017/group6_project_db
# Cloud (Atlas): mongodb+srv://<username>:<password>@cluster0.mongodb.net/group6_project_db?retryWrites=true&w=majority
MONGODB_URI="mongodb://${COMPUTERNAME}:27017/group6_project_db"

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Local Mailpit; use provider settings and TLS when connecting to a real SMTP server.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@fptpost.local
MAIL_FROM_NAME=FPTPost
MAIL_TEMPLATE_CACHE=false

